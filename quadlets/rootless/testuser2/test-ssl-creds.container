[Unit]
Description=Test credential isolation with example-ssl-key
# Note: Cannot use Requires/After with system services from user services

[Container]
Image=quay.io/fedora/fedora:43
# Mount credentials directory into container
Volume=%d:/run/credentials:ro
# Disable SELinux labeling for credentials volume
SecurityLabelDisable=true
Exec=/bin/bash -c '\
  echo "Testing credential isolation with testuser2..."; \
  echo "Credentials directory contents:"; \
  ls -la /run/credentials/ || echo "Cannot list credentials"; \
  if [ -r "/run/credentials/example-ssl-key" ]; then \
    echo "SUCCESS: example-ssl-key loaded"; \
    echo "Credential value:"; \
    cat /run/credentials/example-ssl-key; \
  else \
    echo "FAILED: Cannot read example-ssl-key"; \
    exit 1; \
  fi; \
  if [ -r "/run/credentials/example-api-key" ]; then \
    echo "SECURITY VIOLATION: testuser2 can access testuser'\''s credential!"; \
    exit 1; \
  else \
    echo "GOOD: Cannot access example-api-key (as expected)"; \
  fi; \
  sleep 5'

[Service]
# Load credential from rootful systemd-age-creds socket
# Note: Must use absolute path since %t expands to /run/user/1002 in user services
LoadCredential=example-ssl-key:/run/systemd-age-creds.sock
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
