<?xml version="1.0" encoding="utf-8"?>
<zone target="DROP">
  <short>Public</short>
  <description>For use in public areas. Only selected incoming connections are accepted.</description>

  <!-- Allow SSH -->
  <service name="ssh"/>

  <!-- Allow rootless Caddy HTTP+HTTPS -->
  <port port="20510" protocol="tcp"/>
  <port port="20511" protocol="tcp"/>

  <!-- Forward external 80/443 → internal 20510/20511 for rootless Caddy -->
  <forward-port port="80" protocol="tcp" to-port="20510"/>
  <forward-port port="443" protocol="tcp" to-port="20511"/>
</zone>
