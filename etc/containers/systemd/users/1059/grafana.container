[Unit]
Description=Grafana dashboards and alerting
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/var/lib/homelab-config/grafana/provisioning

[Container]
Image=docker.io/grafana/grafana:12.4
PublishPort=20591:3000
Volume=/var/local/lib/grafana:/var/lib/grafana:Z,U
Volume=/var/lib/homelab-config/grafana/provisioning:/etc/grafana/provisioning:ro,z
# Password injected via env file written by ExecStartPre (see [Service] below).
# Cannot mount %d directly: credentials dir is root-owned (mode 0700) inside the
# container, so Grafana's internal UID 472 cannot read it.
EnvironmentFile=%t/grafana-admin.env
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
Notify=healthy
HealthCmd=curl -sf http://127.0.0.1:3000/api/health
HealthStartPeriod=60s
HealthInterval=30s
HealthRetries=5
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=5
LoadCredential=grafana-admin-password:/run/systemd-age-creds.sock
ExecStartPre=/bin/sh -c 'printf "GF_SECURITY_ADMIN_PASSWORD=%s" "$(cat ${CREDENTIALS_DIRECTORY}/grafana-admin-password)" > %t/grafana-admin.env'
ExecStopPost=/bin/rm -f %t/grafana-admin.env

[Install]
WantedBy=default.target
