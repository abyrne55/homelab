[Unit]
Description=Tinyproxy forward proxy (internet bridge for jellynet)
ConditionPathIsDirectory=/var/lib/homelab-config/tinyproxy

[Container]
Image=ghcr.io/abyrne55/tinyproxy-homelab:main
AutoUpdate=registry
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=true
DropCapability=all
Network=jellynet.network
Network=proxynet.network
Volume=/var/lib/homelab-config/tinyproxy:/etc/tinyproxy:ro,z
ReloadSignal=SIGUSR1
HealthCmd=CMD /bin/curl -sf -x http://127.0.0.1:8888 http://tinyproxy.stats/
HealthStartPeriod=5s
HealthInterval=30s
HealthRetries=3
Notify=healthy

[Service]
ExecStartPre=/usr/bin/cosign verify --certificate-identity-regexp='https://github.com/abyrne55/tinyproxy-homelab/.*' --certificate-oidc-issuer='https://token.actions.githubusercontent.com' ghcr.io/abyrne55/tinyproxy-homelab:main
Restart=on-failure
RestartSec=5
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
