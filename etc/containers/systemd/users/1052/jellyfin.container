[Unit]
Description=Jellyfin Media Server
After=tinyproxy.service

[Container]
Image=docker.io/jellyfin/jellyfin:latest
PublishPort=8096:8096
Network=jellynet.network
Volume=/var/mnt/media/media:/media:ro
Volume=/var/mnt/media/.jellyfin/config:/config:Z
Volume=/var/mnt/media/.jellyfin/cache:/cache:Z
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
HealthCmd=curl -sf http://127.0.0.1:8096/health
HealthStartPeriod=60s
HealthInterval=10s
Notify=healthy
Environment=HTTP_PROXY=http://systemd-tinyproxy:8888
Environment=HTTPS_PROXY=http://systemd-tinyproxy:8888

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
