[Unit]
Description=Jellyfin Media Server

[Container]
Image=docker.io/jellyfin/jellyfin:latest
PublishPort=8096:8096
Volume=/var/mnt/media:/media:ro
Volume=/var/mnt/media/.jellyfin/config:/config:Z
Volume=/var/mnt/media/.jellyfin/cache:/cache:Z
AutoUpdate=registry
NoNewPrivileges=true
HealthCmd=curl -sf http://127.0.0.1:8096/health
HealthStartPeriod=30s
HealthInterval=10s
Notify=healthy

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
