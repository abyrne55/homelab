[Unit]
Description=Home Assistant
After=network-online.target matter-server.service
Wants=network-online.target
ConditionPathExists=/var/lib/homelab-config/home-assistant/configuration.yaml

[Container]
Image=ghcr.io/home-assistant/home-assistant:2026.9.3@sha256:d8922685169707fd91e8b9729902d975f06157d005e422874d201e0261dda196
Pod=home-assistant.pod
Volume=/var/local/lib/home-assistant/config:/config:Z
Volume=/var/lib/homelab-config/home-assistant/configuration.yaml:/config/configuration.yaml:ro
NoNewPrivileges=true
# DropCapability=all intentionally omitted: HA runs as root internally and
# needs capabilities for hardware/network integration features
HealthCmd=curl -f http://localhost:8123/
HealthStartPeriod=300s
HealthInterval=30s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
