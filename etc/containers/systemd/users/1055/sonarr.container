[Unit]
Description=Sonarr TV series management
After=network-online.target sonarr-init-config.service
Wants=network-online.target sonarr-init-config.service sonarr-configure.service

[Container]
Image=lscr.io/linuxserver/sonarr:4.0.16
PublishPort=20550:8989
Volume=/var/mnt/data/content:/content:rw,z
Volume=/var/local/lib/sonarr/config:/config:Z
AutoUpdate=registry
NoNewPrivileges=true
# DropCapability=all intentionally omitted: linuxserver s6 init calls setgroups()
# to switch from root to PUID/PGID, which requires CAP_SETGID inside the container
HealthCmd=curl -f http://localhost:8989/
HealthStartPeriod=60s
HealthInterval=30s
Notify=healthy
Environment=PUID=1055
# PGID=1: in the rootless user namespace, container GID 1 maps to host GID 2000 (content-writers)
# via the sonarr:2000:1 subgid entry. This gives the app process host effective GID 2000,
# satisfying fs.protected_hardlinks for files owned by qbittorrent with group content-writers.
Environment=PGID=1
Environment=UMASK=002
Environment=TZ=UTC

[Service]
Restart=on-failure
RestartSec=5
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
