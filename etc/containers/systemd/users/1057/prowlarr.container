[Unit]
Description=Prowlarr indexer manager
After=network-online.target prowlarr-init-config.service
Wants=network-online.target prowlarr-init-config.service prowlarr-configure.service

[Container]
Image=lscr.io/linuxserver/prowlarr:2.3.5@sha256:6df73ab9e99d0dbaad27c39d8a47c600333eebea80fcb56253a0bb8b630c8115
PublishPort=20570:9696
Volume=/var/local/lib/prowlarr/config:/config:Z
NoNewPrivileges=true
# DropCapability=all intentionally omitted: linuxserver s6 init calls setgroups()
# to switch from root to PUID/PGID, which requires CAP_SETGID inside the container
HealthCmd=curl -f http://localhost:9696/
HealthStartPeriod=120s
HealthInterval=30s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy
Environment=PUID=1057
Environment=PGID=1057

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=20min

[Install]
WantedBy=default.target
