[Unit]
Description=qBittorrent torrent client
After=gluetun.service
Requires=gluetun.service
Wants=qbittorrent-configure.service

[Container]
Image=lscr.io/linuxserver/qbittorrent:latest
AutoUpdate=registry
Pod=torrent.pod
Environment=PUID=1053
# PGID=1: in the rootless user namespace, container GID 1 maps to host GID 2000 (content-writers)
# via the qbittorrent:2000:1 subgid entry. Files created under setgid content/ dirs get GID 2000.
Environment=PGID=1
Environment=UMASK=002
Environment=TZ=UTC
Environment=WEBUI_PORT=20530
Volume=/var/mnt/data/.qbittorrent/config:/config:Z
Volume=/var/mnt/data/content/torrents:/downloads:Z
HealthCmd=curl -f http://localhost:20530/
HealthStartPeriod=30s
HealthInterval=30s
Notify=healthy
NoNewPrivileges=true
# DropCapability=all intentionally omitted: linuxserver s6 init calls setgroups()
# to switch from root to PUID/PGID, which requires CAP_SETGID inside the container

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
