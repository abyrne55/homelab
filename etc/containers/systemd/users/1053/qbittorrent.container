[Unit]
Description=qBittorrent torrent client
After=gluetun.service
BindsTo=gluetun.service
Wants=qbittorrent-configure.service
Wants=demo-media.service

[Container]
Image=lscr.io/linuxserver/qbittorrent:5.1.4@sha256:c9990949e968e99333f47f49da7d16e81ba6e1469c8c46807a65b984c9e8b6ff
Pod=torrent.pod
Environment=PUID=1053
# PGID=1: in the rootless user namespace, container GID 1 maps to host GID 2000 (content-writers)
# via the qbittorrent:2000:1 subgid entry. Combined with the setgid bit on /var/mnt/data/content,
# downloaded files get GID 2000, allowing radarr/sonarr to read and hardlink them.
Environment=PGID=1
Environment=UMASK=002
Environment=WEBUI_PORT=20530
Volume=/var/local/lib/qbittorrent/config:/config:Z
Volume=/var/mnt/data/content/torrents:/downloads:z
HealthCmd=curl -f http://localhost:20530/
HealthStartPeriod=120s
HealthInterval=30s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy
NoNewPrivileges=true
# DropCapability=all intentionally omitted: linuxserver s6 init calls setgroups()
# to switch from root to PUID/PGID, which requires CAP_SETGID inside the container

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=20min

[Install]
WantedBy=default.target
