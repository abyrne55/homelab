[Unit]
Description=Gluetun VPN client (Mullvad WireGuard)

[Container]
Image=docker.io/qmcgaw/gluetun:v3
AutoUpdate=registry
Pod=torrent.pod
# WireGuard requires NET_ADMIN to create tunnel interface in user namespace
# NET_RAW required for ICMP-based healthchecks
AddCapability=NET_ADMIN NET_RAW
# TUN device required for WireGuard
AddDevice=/dev/net/tun
# Required for WireGuard routing rules in rootless containers
Sysctl=net.ipv4.conf.all.src_valid_mark=1
Environment=VPN_SERVICE_PROVIDER=mullvad
Environment=VPN_TYPE=wireguard
Environment=WIREGUARD_PRIVATE_KEY_SECRETFILE=%d/mullvad-wireguard-private-key
Environment=WIREGUARD_ADDRESSES_SECRETFILE=%d/mullvad-wireguard-address
HealthCmd=/gluetun-entrypoint healthcheck
HealthStartPeriod=60s
HealthInterval=10s
Notify=healthy

[Service]
Restart=on-failure
RestartSec=10
LoadCredential=mullvad-wireguard-private-key:/run/systemd-age-creds.sock
LoadCredential=mullvad-wireguard-address:/run/systemd-age-creds.sock

[Install]
WantedBy=default.target
