[Unit]
Description=Radarr media management
After=network-online.target radarr-init-config.service
Wants=network-online.target radarr-init-config.service radarr-configure.service radarr-demo-media.service

[Container]
Image=lscr.io/linuxserver/radarr:6.0.4
PublishPort=20540:7878
Volume=/var/mnt/data/content:/content:rw,z
Volume=/var/local/lib/radarr/config:/config:Z
AutoUpdate=registry
NoNewPrivileges=true
# DropCapability=all intentionally omitted: linuxserver s6 init calls setgroups()
# to switch from root to PUID/PGID, which requires CAP_SETGID inside the container
HealthCmd=curl -f http://localhost:7878/
HealthStartPeriod=60s
HealthInterval=30s
Notify=healthy
Environment=PUID=1054
# PGID=1: in the rootless user namespace, container GID 1 maps to host GID 2000 (content-writers)
# via the radarr:2000:1 subgid entry. This gives the app process host effective GID 2000,
# satisfying fs.protected_hardlinks for files owned by qbittorrent with group content-writers.
Environment=PGID=1
Environment=UMASK=002
Environment=TZ=UTC

[Service]
Restart=on-failure
RestartSec=5
ProtectHostname=yes

[Install]
WantedBy=default.target
