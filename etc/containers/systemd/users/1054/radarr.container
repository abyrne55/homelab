[Unit]
Description=Radarr media management
After=network-online.target
Wants=network-online.target

[Container]
Image=lscr.io/linuxserver/radarr:6.0.4
PublishPort=20540:7878
Volume=/var/mnt/data/content:/content:rw,Z
Volume=/var/mnt/data/.radarr/config:/config:Z
AutoUpdate=registry
NoNewPrivileges=true
# DropCapability=all intentionally omitted: linuxserver s6 init calls setgroups()
# to switch from root to PUID/PGID, which requires CAP_SETGID inside the container
HealthCmd=curl -f http://localhost:7878/
HealthStartPeriod=30s
HealthInterval=30s
Notify=healthy
# Mount host credentials directory into the container so credential file paths resolve
Volume=%d:/run/credentials:ro,z
Environment=PUID=1054
Environment=PGID=2000
Environment=UMASK=002
GroupAdd=keep-groups
Environment=TZ=UTC

[Service]
Restart=on-failure
RestartSec=5
LoadCredential=qbittorrent-webui-password:/run/systemd-age-creds.sock

[Install]
WantedBy=default.target
