[Unit]
Description=Inject pre-generated secrets from secrets ISO
# Must run before services that would generate keys
Before=age-generate-identity.service ssh-generate-identity.service
# Ensure disk subsystem is ready
After=local-fs.target
# Only run if secrets ISO is attached
ConditionPathExists=/dev/disk/by-label/SECRETS

[Service]
Type=oneshot
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectSystem=strict
ProtectHome=yes
# PrivateDevices intentionally omitted: service mounts /dev/disk/by-label/SECRETS
# /var/lib/age doesn't exist at first boot (this service creates it), so we
# can't use the specific subpath — bind-mount setup would fail at namespace setup.
ReadWritePaths=/var/mnt /var/lib
# All operations (mount, copy, umount) are consolidated into a single script:
# namespace-creating directives above give each ExecStart= step a fresh mount
# namespace clone from PID 1, so a mount in one step would be invisible to
# subsequent steps. A single script avoids this while preserving isolation.
ExecStart=/usr/local/bin/secrets-inject

[Install]
WantedBy=multi-user.target
