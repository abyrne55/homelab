[Unit]
Description=Sync homelab-secrets repository
Wants=network-online.target
After=network-online.target ssh-generate-identity.service age-generate-identity.service

[Service]
Type=oneshot
Restart=on-failure
RestartSec=30
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/age
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=yes
ProtectClock=yes
MemoryDenyWriteExecute=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
ProtectProc=noaccess
ProcSubset=pid
UMask=0077

# Set Git SSH command to use the generated key and known_hosts
Environment="GIT_SSH_COMMAND=ssh -i /var/lib/git-ssh/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/var/lib/git-ssh/known_hosts -o StrictHostKeyChecking=yes"

# Clone on first run only. Guarded on .git rather than the directory, since
# the directory may already exist empty. No '-' prefix, so a real clone
# failure is reported as such.
ExecStartPre=/bin/sh -c 'test -d /var/lib/age/credentials/.git || exec /usr/bin/git clone git@github.com:abyrne55/homelab-secrets.git /var/lib/age/credentials'

# Always hard-reset to remote state, discarding any local changes
ExecStart=/usr/bin/git -C /var/lib/age/credentials/ fetch --all
ExecStart=/usr/bin/git -C /var/lib/age/credentials/ reset --hard @{u}

[Install]
WantedBy=multi-user.target
