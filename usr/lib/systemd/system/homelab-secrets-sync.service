[Unit]
Description=Sync homelab-secrets repository
Wants=network-online.target
After=network-online.target ssh-generate-identity.service age-generate-identity.service

[Service]
Type=oneshot
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/age/credentials
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=yes

# Set Git SSH command to use the generated key and known_hosts
Environment="GIT_SSH_COMMAND=ssh -i /var/lib/git-ssh/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/var/lib/git-ssh/known_hosts -o StrictHostKeyChecking=yes"

# This clone is expected to fail after the first run
ExecStartPre=-/usr/bin/git clone git@github.com:abyrne55/homelab-secrets.git /var/lib/age/credentials

# The pull will always happen regardless
ExecStart=/usr/bin/git -C /var/lib/age/credentials/ pull --ff-only

[Install]
WantedBy=multi-user.target
