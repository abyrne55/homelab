[Unit]
Description=Generate age keypair
ConditionPathExists=!/var/lib/age/identity.txt
After=local-fs.target

[Service]
Type=oneshot
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
# /var/lib/age doesn't exist at first boot (this service creates it), so we
# can't use the specific subpath — bind-mount setup would fail at namespace setup.
ReadWritePaths=/var/lib

ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/age
ExecStart=/usr/bin/age-keygen -pq -o /var/lib/age/identity.txt
ExecStartPost=/usr/bin/age-keygen -y -o /var/lib/age/identity.pub /var/lib/age/identity.txt
ExecStartPost=/usr/bin/chmod 400 /var/lib/age/identity.txt
ExecStartPost=/usr/bin/chmod 444 /var/lib/age/identity.pub

[Install]
WantedBy=multi-user.target
