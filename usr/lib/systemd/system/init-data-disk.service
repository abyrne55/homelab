[Unit]
Description=Initialize data disk with ext4 filesystem
DefaultDependencies=no
Before=var-mnt-media.mount
After=systemd-udevd.service var.mount
ConditionPathExists=!/dev/disk/by-label/media-data

[Service]
Type=oneshot
ExecStart=/usr/bin/mkdir -p /var/mnt/media /var/mnt/.media-init
ExecStart=/usr/sbin/mkfs.ext4 -L media-data /dev/vdb
ExecStart=/usr/bin/mount /dev/vdb /var/mnt/.media-init
ExecStart=/usr/bin/mkdir -p \
  /var/mnt/.media-init/media/movies \
  /var/mnt/.media-init/media/tv \
  /var/mnt/.media-init/media/music \
  /var/mnt/.media-init/media/books \
  /var/mnt/.media-init/media/other \
  /var/mnt/.media-init/torrents/movies \
  /var/mnt/.media-init/torrents/tv \
  /var/mnt/.media-init/torrents/music \
  /var/mnt/.media-init/torrents/books \
  /var/mnt/.media-init/torrents/other \
  /var/mnt/.media-init/usenet/incomplete \
  /var/mnt/.media-init/usenet/complete/movies \
  /var/mnt/.media-init/usenet/complete/tv \
  /var/mnt/.media-init/usenet/complete/music \
  /var/mnt/.media-init/usenet/complete/books \
  /var/mnt/.media-init/usenet/complete/other \
  /var/mnt/.media-init/.jellyfin/config \
  /var/mnt/.media-init/.jellyfin/cache \
  /var/mnt/.media-init/.qbittorrent/config
ExecStart=/usr/bin/chown -R 1052:1052 /var/mnt/.media-init/.jellyfin /var/mnt/.media-init/media
ExecStart=/usr/bin/chown -R 1053:1053 /var/mnt/.media-init/.qbittorrent /var/mnt/.media-init/torrents
ExecStart=/usr/bin/umount /var/mnt/.media-init
ExecStart=/usr/bin/rmdir /var/mnt/.media-init
RemainAfterExit=yes

[Install]
WantedBy=var-mnt-media.mount
