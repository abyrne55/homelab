[Unit]
Description=Initialize data disk with ext4 filesystem
DefaultDependencies=no
Before=var-mnt-data.mount
After=systemd-udevd.service var.mount
ConditionPathExists=!/dev/disk/by-label/data

[Service]
Type=oneshot
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
# All mount-namespace-creating directives (PrivateTmp, PrivateDevices,
# ProtectSystem, ProtectHome, ProtectKernelTunables, ProtectKernelModules,
# ProtectKernelLogs, ProtectControlGroups) intentionally omitted: systemd
# gives each ExecStart= step a fresh clone of the service namespace, so a
# mount created in one step is invisible to subsequent steps. This service
# must run mount and umount across separate ExecStart= lines and therefore
# cannot use any directive that creates a private mount namespace.
ExecStart=/usr/bin/mkdir -p /var/mnt/data /var/mnt/.data-init
ExecStart=/usr/sbin/mkfs.ext4 -L data /dev/vdb
ExecStart=/usr/bin/mount /dev/vdb /var/mnt/.data-init
ExecStart=/usr/bin/mkdir -p \
  /var/mnt/.data-init/content/media/movies \
  /var/mnt/.data-init/content/media/tv \
  /var/mnt/.data-init/content/media/music \
  /var/mnt/.data-init/content/media/books \
  /var/mnt/.data-init/content/media/other \
  /var/mnt/.data-init/content/torrents/movies \
  /var/mnt/.data-init/content/torrents/tv \
  /var/mnt/.data-init/content/torrents/music \
  /var/mnt/.data-init/content/torrents/books \
  /var/mnt/.data-init/content/torrents/other \
  /var/mnt/.data-init/content/usenet/incomplete \
  /var/mnt/.data-init/content/usenet/complete/movies \
  /var/mnt/.data-init/content/usenet/complete/tv \
  /var/mnt/.data-init/content/usenet/complete/music \
  /var/mnt/.data-init/content/usenet/complete/books \
  /var/mnt/.data-init/content/usenet/complete/other \
  /var/mnt/.data-init/.jellyfin/config \
  /var/mnt/.data-init/.jellyfin/cache \
  /var/mnt/.data-init/.qbittorrent/config \
  /var/mnt/.data-init/.radarr/config \
  /var/mnt/.data-init/.sonarr/config \
  /var/mnt/.data-init/.configarr/repos \
  /var/mnt/.data-init/.prowlarr/config \
  /var/mnt/.data-init/.home-assistant/config \
  /var/mnt/.data-init/.home-assistant/matter-server
ExecStart=/usr/bin/chown -R 1052:1052 /var/mnt/.data-init/.jellyfin
ExecStart=/usr/bin/chown -R 1053:1053 /var/mnt/.data-init/.qbittorrent
ExecStart=/usr/bin/chown -R 1054:1054 /var/mnt/.data-init/.radarr
ExecStart=/usr/bin/chown -R 1055:1055 /var/mnt/.data-init/.sonarr
ExecStart=/usr/bin/chown -R 1056:1056 /var/mnt/.data-init/.configarr
ExecStart=/usr/bin/chown -R 1057:1057 /var/mnt/.data-init/.prowlarr
ExecStart=/usr/bin/chown -R 1058:1058 /var/mnt/.data-init/.home-assistant
# Set content-writers (GID 2000) as group for entire content tree
ExecStart=/usr/bin/chown -R :2000 /var/mnt/.data-init/content
# Override UID for service-specific subdirs (group stays 2000)
ExecStart=/usr/bin/chown -R 1053 /var/mnt/.data-init/content/torrents
ExecStart=/usr/bin/chown -R 1054 /var/mnt/.data-init/content/media
# setgid (2) ensures new subdirs inherit GID 2000; 775 gives group rw
ExecStart=/usr/bin/chmod -R 2775 /var/mnt/.data-init/content
ExecStart=/usr/bin/umount /var/mnt/.data-init
ExecStart=/usr/bin/rmdir /var/mnt/.data-init
RemainAfterExit=yes

[Install]
WantedBy=var-mnt-data.mount
