[Unit]
Description=NFS mount for NAS media share
After=sys-subsystem-net-devices-wg318.device
BindsTo=sys-subsystem-net-devices-wg318.device

[Mount]
What=100.100.100.1:/volume1/media-stg
Where=/var/mnt/data
Type=nfs
Options=_netdev,nfsvers=4.1,nconnect=4,noatime,nosuid,nodev,noexec,rsize=131072,wsize=131072,soft,retrans=3,timeo=300,context=system_u:object_r:container_file_t:s0
TimeoutSec=30
