[Unit]
Description=WireGuard VPN tunnel to NAS
After=network-online.target
Wants=network-online.target
Before=var-mnt-data.mount

[Service]
Type=oneshot
RemainAfterExit=yes
# NoNewPrivileges and directives implying it (ProtectKernelTunables,
# ProtectKernelModules, ProtectKernelLogs, RestrictRealtime,
# RestrictAddressFamilies, PrivateDevices) intentionally omitted:
# ip(8) has SELinux type ifconfig_exec_t which requires a domain transition
# from init_t to ifconfig_t. NO_NEW_PRIVS blocks all transitions to
# non-bounded domains (avc: denied { nnp_transition }).
PrivateTmp=yes
ProtectControlGroups=yes
LockPersonality=yes
ProtectSystem=strict
ProtectHome=yes
# PrivateNetwork=yes must NOT be set — it disconnects AF_NETLINK, which
# is required by ip(8) and wg(8) to configure interfaces via the kernel
LoadCredential=wg-nas-private-key:%t/systemd-age-creds.sock
LoadCredential=wg-nas-preshared-key:%t/systemd-age-creds.sock
ExecStart=ip link add wg-nas type wireguard
ExecStart=wg set wg-nas \
    private-key /run/credentials/wg-nas.service/wg-nas-private-key \
    peer FyNIe8zCEFrkvDgW7VFI1kDVHMnnqwIr2rTrbRvb3Dw= \
        preshared-key /run/credentials/wg-nas.service/wg-nas-preshared-key \
        allowed-ips 10.8.0.1/32 \
        endpoint 192.168.0.167:51820 \
        persistent-keepalive 25
ExecStart=ip address add 10.8.0.3/32 dev wg-nas
ExecStart=ip link set wg-nas up mtu 1420
ExecStart=ip route add 10.8.0.1/32 dev wg-nas
ExecStop=ip link delete wg-nas

[Install]
WantedBy=multi-user.target
