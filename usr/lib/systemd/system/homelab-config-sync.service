[Unit]
Description=Sync homelab-config repository
Wants=network-online.target
After=network-online.target ssh-generate-identity.service

[Service]
Type=oneshot
Restart=on-failure
RestartSec=30
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/homelab-config
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=yes
ProtectClock=yes
MemoryDenyWriteExecute=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
ProtectProc=noaccess
ProcSubset=pid
# UMask=0077 intentionally omitted: git clone creates dirs/files owned by root,
# and they must be readable by container users (e.g. caddy UID 1051). Default
# root umask (0022) gives 755/644 which is correct here. The SELinux label is
# set to container_file_t by the chcon ExecStartPost step.

# Set Git SSH command to use the generated key and known_hosts
Environment="GIT_SSH_COMMAND=ssh -i /var/lib/git-ssh/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/var/lib/git-ssh/known_hosts -o StrictHostKeyChecking=yes"

# This clone is expected to fail after the first run
ExecStartPre=-/usr/bin/git clone git@github.com:abyrne55/homelab-config.git /var/lib/homelab-config

# Always hard-reset to remote state, discarding any local changes
ExecStart=/usr/bin/git -C /var/lib/homelab-config/ fetch --all
ExecStart=/usr/bin/git -C /var/lib/homelab-config/ reset --hard @{u}

# Relabel repo contents so rootless containers can read them (var_lib_t → container_file_t)
ExecStartPost=/usr/bin/chcon -Rt container_file_t /var/lib/homelab-config/

# Start Caddy if not running, or hot-reload it if already active
ExecStartPost=-/usr/bin/systemctl --user -M caddy@.host reload-or-restart caddy.service
# Reload Tinyproxy via SIGUSR1, or start it if not running (ReloadSignal=SIGUSR1 in quadlet)
ExecStartPost=-/usr/bin/systemctl --user -M jellyfin@.host reload-or-restart tinyproxy.service
# Restart Home Assistant to pick up configuration.yaml changes
ExecStartPost=-/usr/bin/systemctl --user -M home-assistant@.host restart home-assistant.service

[Install]
WantedBy=multi-user.target
