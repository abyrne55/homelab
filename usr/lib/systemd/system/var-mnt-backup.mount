[Unit]
Description=NFS mount for NAS backup share
After=network-online.target wg-nas.service var-mnt-data.mount
Wants=network-online.target
BindsTo=wg-nas.service

[Mount]
What=100.100.100.1:/volume1/hlbkup
Where=/var/mnt/backup
Type=nfs
Options=defaults,_netdev,nfsvers=4.1,nconnect=4,noatime,rsize=131072,wsize=131072
TimeoutSec=600

[Install]
WantedBy=multi-user.target
