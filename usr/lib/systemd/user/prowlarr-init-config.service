[Unit]
Description=Initialize Prowlarr config.xml with API key
ConditionUser=prowlarr
ConditionPathExists=!/var/local/lib/prowlarr/config/config.xml
Before=prowlarr.service
PartOf=prowlarr.service

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredential=prowlarr-api-key:/run/systemd-age-creds.sock
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/local/lib/prowlarr/config
LockPersonality=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ExecStart=/usr/local/bin/prowlarr-init-config
