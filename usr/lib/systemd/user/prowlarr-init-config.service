[Unit]
Description=Initialize Prowlarr config.xml with API key
ConditionUser=prowlarr
PartOf=prowlarr.service
Before=prowlarr.service

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=3s

ExecStart=/usr/local/bin/prowlarr-init-config

LoadCredential=prowlarr-api-key:/run/systemd-age-creds.sock

NoNewPrivileges=yes
UMask=0077
IPAddressDeny=any
MemoryDenyWriteExecute=yes
RemoveIPC=yes
LockPersonality=yes
RestrictAddressFamilies=none
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @resources @swap
