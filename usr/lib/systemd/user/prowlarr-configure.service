[Unit]
Description=Configure Prowlarr Forms authentication and app connections
ConditionUser=prowlarr
PartOf=prowlarr.service
After=prowlarr.service

[Service]
Type=oneshot

ExecStart=/bin/bash -o pipefail -c '/usr/local/bin/prowlarr-configure 2>&1 | /usr/local/bin/redact-secrets'

Restart=on-failure
RestartSec=10

LoadCredential=prowlarr-api-key:/run/systemd-age-creds.sock
LoadCredential=prowlarr-webui-password:/run/systemd-age-creds.sock
LoadCredential=sonarr-api-key:/run/systemd-age-creds.sock
LoadCredential=radarr-api-key:/run/systemd-age-creds.sock

NoNewPrivileges=yes
PrivateTmp=yes
PrivateUsers=yes

ProtectSystem=strict
ProtectHome=tmpfs
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectProc=invisible

LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET
SystemCallArchitectures=native
