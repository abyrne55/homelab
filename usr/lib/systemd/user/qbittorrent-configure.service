[Unit]
Description=Set qBittorrent permanent WebUI password on first start
PartOf=qbittorrent.service
After=qbittorrent.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/qbittorrent-configure
LoadCredential=qbittorrent-webui-password:/run/systemd-age-creds.sock
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
LockPersonality=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# ProtectHome=yes intentionally omitted: qbittorrent-configure calls
# systemctl --user and journalctl --user which communicate via /run/user/<uid>/
