[Unit]
Description=Initialize Radarr config.xml with API key
ConditionUser=radarr
ConditionPathExists=!/var/local/lib/radarr/config/config.xml
Before=radarr.service
PartOf=radarr.service

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredential=radarr-api-key:/run/systemd-age-creds.sock
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/local/lib/radarr/config
LockPersonality=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ExecStart=/usr/local/bin/radarr-init-config
