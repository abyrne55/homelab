[Unit]
Description=Initialize Radarr config.xml with API key
ConditionUser=radarr
ConditionPathExists=!/var/mnt/data/.radarr/config/config.xml
Before=radarr.service
PartOf=radarr.service

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredential=radarr-api-key:/run/systemd-age-creds.sock
ExecStart=/usr/local/bin/radarr-init-config
