#!/usr/bin/bash
# Pre-flight for greenboot: polls until required services are active or timeout.
# Always exits 0 — pass/fail decisions belong to the greenboot check scripts.
set -uo pipefail

TIMEOUT=400
INTERVAL=10
ELAPSED=0

REQUIRED_SYSTEM=(homelab-secrets-sync.service homelab-config-sync.service)
# "username service" pairs (username, not UID — consistent with hl's ctl())
REQUIRED_USER=("caddy caddy.service")

is_sync_done() {
    local svc=$1
    local result
    result=$(systemctl show "$svc" -p Result --value 2>/dev/null)
    [ "$result" = "success" ]
}

is_user_active() {
    local user=$1 svc=$2
    systemctl --user -M "${user}@.host" is-active --quiet "$svc" 2>/dev/null
}

while true; do
    ALL_READY=true

    for svc in "${REQUIRED_SYSTEM[@]}"; do
        if ! is_sync_done "$svc"; then
            ALL_READY=false
            echo "wait-for-quadlets: waiting for $svc (${ELAPSED}s elapsed)"
        fi
    done

    for entry in "${REQUIRED_USER[@]}"; do
        user="${entry%% *}"
        svc="${entry#* }"
        if ! is_user_active "$user" "$svc"; then
            ALL_READY=false
            echo "wait-for-quadlets: waiting for $svc user=$user (${ELAPSED}s elapsed)"
        fi
    done

    $ALL_READY && { echo "wait-for-quadlets: all required services ready after ${ELAPSED}s"; exit 0; }

    if (( ELAPSED >= TIMEOUT )); then
        echo "wait-for-quadlets: timeout after ${TIMEOUT}s, proceeding to greenboot checks"
        exit 0
    fi

    sleep "$INTERVAL"
    (( ELAPSED += INTERVAL )) || true
done
