#!/usr/bin/bash
# Pre-flight for greenboot: polls until required services are healthy or timeout.
# Always exits 0 — pass/fail decisions belong to the greenboot check scripts.
set -uo pipefail

TIMEOUT=400
INTERVAL=10
ELAPSED=0

log() { echo "wait-for-quadlets: $*"; }

# Check that a oneshot service completed with Result=success
is_sync_done() {
    local svc=$1 result
    result=$(systemctl show "$svc" -p Result --value 2>/dev/null) || return 1
    [ "$result" = "success" ]
}

# Check that a rootless podman container is healthy.
# Uses --root/--runroot so no D-Bus or user session socket is needed.
is_container_healthy() {
    local home=$1 uid=$2 name=$3 status
    status=$(podman --root "${home}/.local/share/containers/storage" \
                    --runroot "/run/user/${uid}/containers" \
                    ps --filter "name=${name}" --format '{{.Status}}' 2>/dev/null) || return 1
    [[ "$status" == *"(healthy)"* ]]
}

while true; do
    all_ready=true

    for svc in homelab-secrets-sync.service homelab-config-sync.service; do
        if ! is_sync_done "$svc"; then
            all_ready=false
            log "waiting for $svc (${ELAPSED}s)"
        fi
    done

    if ! is_container_healthy /var/home/caddy 1051 caddy; then
        all_ready=false
        log "waiting for caddy container to be healthy (${ELAPSED}s)"
    fi

    if [ "$all_ready" = true ]; then
        log "all required services ready after ${ELAPSED}s"
        exit 0
    fi

    if (( ELAPSED >= TIMEOUT )); then
        log "timeout after ${TIMEOUT}s, proceeding to greenboot checks"
        exit 0
    fi

    sleep "$INTERVAL"
    ELAPSED=$(( ELAPSED + INTERVAL ))
done
