#!/bin/bash
# Filter stdin, replacing every value found in $CREDENTIALS_DIRECTORY with
# [REDACTED], then write to stdout. Falls back to cat if CREDENTIALS_DIRECTORY
# is unset or empty.
#
# Intended use — wrap any command whose output may contain credential values:
#
#   some-command 2>&1 | redact-secrets
#
# Or redirect all output of a script through it at the unit level:
#
#   ExecStart=/bin/bash -o pipefail -c '/usr/local/bin/my-script 2>&1 | /usr/local/bin/redact-secrets'
set -euo pipefail

if [[ -z "${CREDENTIALS_DIRECTORY:-}" ]] || [[ ! -d "$CREDENTIALS_DIRECTORY" ]]; then
    exec cat
fi

sed_args=()
for cred_file in "$CREDENTIALS_DIRECTORY"/*; do
    [[ -f "$cred_file" ]] || continue
    value=$(cat "$cred_file")
    [[ -z "$value" ]] && continue
    # Escape characters special in sed's s/// expression: / \ &
    escaped=$(printf '%s' "$value" | sed 's/[\/&]/\\&/g')
    sed_args+=(-e "s/${escaped}/[REDACTED]/g")
done

if [[ ${#sed_args[@]} -eq 0 ]]; then
    exec cat
fi

exec sed -u "${sed_args[@]}"
