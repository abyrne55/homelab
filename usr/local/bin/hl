#!/bin/bash
set -euo pipefail

PROG=$(basename "$0")

usage() {
  cat <<EOF
Usage: $PROG [command] [options]

Homelab service management CLI.

Commands:
  (no args)                          Status summary across system and all service users
  status [-s] [-u <user>] [<unit>]   Unit status; without <unit>, shows all for user(s)
  logs   [-s] [-u <user>] <unit> [flags...]  Journal logs (extra flags passed to journalctl)
  restart [-s] [-u <user>] <unit>    Restart a unit
  start   [-s] [-u <user>] <unit>    Start a unit
  stop    [-s] [-u <user>] <unit>    Stop a unit
  list   [-s] [-u <user>]            List units for system or service user(s)
  ps     [-u <user>]                 Show running Podman containers
  sudo   [-u <user>] <container> [--] <cmd...>  Run a command inside a container
  users                              List discovered service users
  update [-u <user>]                 Trigger podman-auto-update.service
  failed                             List failed units across system and all service users
  help                               Print this help

Options:
  -s, --system        Target system units instead of a service user
  -u, --user <user>   Target a specific service user (defaults to unit name)
  -h, --help          Print this help

Examples:
  $PROG                                    # status summary for system + all users
  $PROG status jellyfin                    # status of jellyfin.service under jellyfin user
  $PROG status -s homelab-config-sync      # status of a system unit
  $PROG logs jellyfin -n 50               # last 50 log lines for jellyfin
  $PROG logs -s homelab-secrets-sync -n 50 # last 50 lines for a system unit
  $PROG logs -u jellyfin tinyproxy         # logs for tinyproxy (secondary service)
  $PROG restart qbittorrent               # restart qbittorrent.service
  $PROG restart -s homelab-config-sync    # restart a system unit
  $PROG ps                                # running containers across all users
  $PROG sudo jellyfin -- ls /              # run ls inside jellyfin container
  $PROG sudo -u jellyfin tinyproxy -- sh   # shell into tinyproxy (jellyfin's user)
  $PROG update                            # trigger auto-update for all users
EOF
}

# Discover service users: query active user@<uid>.service instances, resolve to usernames,
# exclude core (the interactive user).
discover_users() {
  systemctl list-units 'user@*.service' --state=active --no-legend --plain 2>/dev/null \
    | awk '{print $1}' \
    | sed 's/user@\([0-9]*\)\.service/\1/' \
    | while read -r uid; do
        getent passwd "$uid" 2>/dev/null | cut -d: -f1
      done \
    | grep -v '^core$' \
    | sort -u
}

user_uid() {
  id -u "$1" 2>/dev/null
}

ctl() {
  local user="$1"; shift
  sudo systemctl --user -M "${user}@.host" "$@"
}

sctl() {
  sudo systemctl "$@"
}

sjctl() {
  local unit="$1"; shift
  sudo journalctl -u "$unit" "$@"
}

# journalctl --user -M user@.host is rejected ("Connecting to a machine as non-root
# is not supported"), so match by journal fields instead.
jctl() {
  local user="$1"
  local unit="$2"
  shift 2
  local uid
  uid=$(user_uid "$user")
  sudo journalctl "_SYSTEMD_USER_UNIT=${unit}" "_UID=${uid}" "$@"
}

# sudo -u user keeps the CWD (/var/home/core) which the service user can't read.
# Use `su -` to switch to the service user's login environment instead.
podman_ps() {
  local user="$1"
  sudo su - "$user" -s /bin/sh -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) podman ps'
}

cmd_status() {
  local target_user=""
  local unit=""
  local system=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s|--system) system=1; shift ;;
      -u|--user) target_user="$2"; shift 2 ;;
      -*) echo "$PROG: unknown option '$1'" >&2; usage; exit 1 ;;
      *) unit="$1"; shift ;;
    esac
  done

  if [[ $system -eq 1 && -n "$target_user" ]]; then
    echo "$PROG status: -s and -u are mutually exclusive" >&2; exit 1
  fi

  if [[ $system -eq 1 ]]; then
    if [[ -z "$unit" ]]; then
      sctl status --no-pager
    else
      sctl status --no-pager "${unit}.service"
    fi
    return
  fi

  if [[ -z "$target_user" && -z "$unit" ]]; then
    # Summary across system and all service users
    echo "=== system ==="
    systemctl status --no-pager 2>&1 | head -3 || true
    echo
    local users
    mapfile -t users < <(discover_users)
    for user in "${users[@]}"; do
      echo "=== $user ==="
      ctl "$user" status --no-pager 2>&1 | head -3 || true
      echo
    done
    return
  fi

  if [[ -z "$target_user" ]]; then
    target_user="$unit"
  fi

  if [[ -z "$unit" ]]; then
    ctl "$target_user" status --no-pager
  else
    ctl "$target_user" status --no-pager "${unit}.service"
  fi
}

cmd_logs() {
  local target_user=""
  local unit=""
  local system=0
  local extra_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s|--system) system=1; shift ;;
      -u|--user) target_user="$2"; shift 2 ;;
      -*)
        # Remaining args are journalctl flags — collect them all
        extra_args+=("$@")
        break
        ;;
      *)
        if [[ -z "$unit" ]]; then
          unit="$1"; shift
        else
          extra_args+=("$@")
          break
        fi
        ;;
    esac
  done

  if [[ -z "$unit" ]]; then
    echo "$PROG logs: <unit> is required" >&2
    usage
    exit 1
  fi

  if [[ $system -eq 1 && -n "$target_user" ]]; then
    echo "$PROG logs: -s and -u are mutually exclusive" >&2; exit 1
  fi

  if [[ $system -eq 1 ]]; then
    sjctl "${unit}.service" "${extra_args[@]+"${extra_args[@]}"}"
  else
    if [[ -z "$target_user" ]]; then
      target_user="$unit"
    fi
    jctl "$target_user" "${unit}.service" "${extra_args[@]+"${extra_args[@]}"}"
  fi
}

cmd_simple() {
  local action="$1"; shift
  local target_user=""
  local unit=""
  local system=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s|--system) system=1; shift ;;
      -u|--user) target_user="$2"; shift 2 ;;
      -*) echo "$PROG: unknown option '$1'" >&2; usage; exit 1 ;;
      *) unit="$1"; shift ;;
    esac
  done

  if [[ -z "$unit" ]]; then
    echo "$PROG $action: <unit> is required" >&2
    usage
    exit 1
  fi

  if [[ $system -eq 1 && -n "$target_user" ]]; then
    echo "$PROG $action: -s and -u are mutually exclusive" >&2; exit 1
  fi

  if [[ $system -eq 1 ]]; then
    sctl "$action" "${unit}.service"
  else
    if [[ -z "$target_user" ]]; then
      target_user="$unit"
    fi
    ctl "$target_user" "$action" "${unit}.service"
  fi
}

cmd_list() {
  local target_user=""
  local system=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s|--system) system=1; shift ;;
      -u|--user) target_user="$2"; shift 2 ;;
      -*) echo "$PROG: unknown option '$1'" >&2; usage; exit 1 ;;
      *) echo "$PROG: unexpected argument '$1'" >&2; usage; exit 1 ;;
    esac
  done

  if [[ $system -eq 1 && -n "$target_user" ]]; then
    echo "$PROG list: -s and -u are mutually exclusive" >&2; exit 1
  fi

  if [[ $system -eq 1 ]]; then
    echo "=== system ==="
    sctl list-units --no-pager
  elif [[ -n "$target_user" ]]; then
    echo "=== $target_user ==="
    ctl "$target_user" list-units --no-pager
  else
    local users
    mapfile -t users < <(discover_users)
    for user in "${users[@]}"; do
      echo "=== $user ==="
      ctl "$user" list-units --no-pager
      echo
    done
  fi
}

cmd_ps() {
  local target_user=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--user) target_user="$2"; shift 2 ;;
      -*) echo "$PROG: unknown option '$1'" >&2; usage; exit 1 ;;
      *) echo "$PROG: unexpected argument '$1'" >&2; usage; exit 1 ;;
    esac
  done

  if [[ -n "$target_user" ]]; then
    echo "=== $target_user ==="
    podman_ps "$target_user"
  else
    local users
    mapfile -t users < <(discover_users)
    for user in "${users[@]}"; do
      echo "=== $user ==="
      podman_ps "$user"
      echo
    done
  fi
}

cmd_users() {
  discover_users
}

cmd_failed() {
  local any=0

  echo "=== system ==="
  local sys_failed
  sys_failed=$(systemctl list-units --state=failed --no-pager --plain --no-legend 2>/dev/null || true)
  if [[ -n "$sys_failed" ]]; then
    echo "$sys_failed"
    any=1
  else
    echo "(none)"
  fi
  echo

  local users
  mapfile -t users < <(discover_users)
  for user in "${users[@]}"; do
    echo "=== $user ==="
    local user_failed
    user_failed=$(ctl "$user" list-units --state=failed --no-pager --plain --no-legend 2>/dev/null || true)
    if [[ -n "$user_failed" ]]; then
      echo "$user_failed"
      any=1
    else
      echo "(none)"
    fi
    echo
  done

  [[ $any -eq 0 ]]
}

cmd_sudo() {
  local target_user=""
  local container=""
  local cmd_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--user) target_user="$2"; shift 2 ;;
      --) shift; cmd_args=("$@"); break ;;
      -*) echo "$PROG: unknown option '$1'" >&2; usage; exit 1 ;;
      *)
        if [[ -z "$container" ]]; then
          container="$1"; shift
        else
          # No -- separator: rest of args are the command
          cmd_args=("$@"); break
        fi
        ;;
    esac
  done

  if [[ -z "$container" ]]; then
    echo "$PROG sudo: <container> is required" >&2; usage; exit 1
  fi
  if [[ ${#cmd_args[@]} -eq 0 ]]; then
    echo "$PROG sudo: command to run is required" >&2; usage; exit 1
  fi
  if [[ -z "$target_user" ]]; then
    target_user="$container"
  fi

  local quoted_args
  quoted_args=$(printf '%q ' "systemd-${container}" "${cmd_args[@]}")
  sudo su - "$target_user" -s /bin/sh -c "XDG_RUNTIME_DIR=/run/user/\$(id -u) podman exec $quoted_args"
}

cmd_update() {
  local target_user=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--user) target_user="$2"; shift 2 ;;
      -*) echo "$PROG: unknown option '$1'" >&2; usage; exit 1 ;;
      *) echo "$PROG: unexpected argument '$1'" >&2; usage; exit 1 ;;
    esac
  done

  if [[ -n "$target_user" ]]; then
    ctl "$target_user" start podman-auto-update.service
  else
    local users
    mapfile -t users < <(discover_users)
    for user in "${users[@]}"; do
      echo "Triggering auto-update for $user..."
      ctl "$user" start podman-auto-update.service
    done
  fi
}

# Main dispatch
case "${1:-}" in
  -h|--help|help) usage ;;
  "") cmd_status ;;
  status)  shift; cmd_status "$@" ;;
  logs)    shift; cmd_logs "$@" ;;
  restart) shift; cmd_simple restart "$@" ;;
  start)   shift; cmd_simple start "$@" ;;
  stop)    shift; cmd_simple stop "$@" ;;
  list)    shift; cmd_list "$@" ;;
  ps)      shift; cmd_ps "$@" ;;
  sudo)    shift; cmd_sudo "$@" ;;
  users)   cmd_users ;;
  update)  shift; cmd_update "$@" ;;
  failed)  cmd_failed ;;
  *)       echo "$PROG: unknown command '$1'" >&2; usage; exit 1 ;;
esac
