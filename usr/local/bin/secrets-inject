#!/bin/bash
# Inject pre-generated secrets from secrets ISO.
# All mount/copy/umount operations run in a single process so that the ISO
# mount (done first) is visible to subsequent copy commands. If these steps
# were spread across multiple ExecStartPre= lines in the service unit,
# namespace-creating directives (PrivateTmp, ProtectSystem, etc.) would give
# each step a fresh mount namespace clone from PID 1, making the mount
# invisible to later steps.
set -euo pipefail

mkdir -p /var/mnt/secrets
mount -o ro -t iso9660 /dev/disk/by-label/SECRETS /var/mnt/secrets

install -d -m 0700 /var/lib/age
install -d -m 0700 /var/lib/git-ssh

install -m 0400 /var/mnt/secrets/age.key /var/lib/age/identity.txt
install -m 0444 /var/mnt/secrets/age.key.pub /var/lib/age/identity.pub
install -m 0400 /var/mnt/secrets/ssh.key /var/lib/git-ssh/id_ed25519
install -m 0444 /var/mnt/secrets/ssh.key.pub /var/lib/git-ssh/id_ed25519.pub

umount /var/mnt/secrets
rmdir /var/mnt/secrets
