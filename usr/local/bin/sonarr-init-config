#!/bin/bash
set -euo pipefail
config_path=/var/local/lib/sonarr/config/config.xml
if [[ -f "$config_path" ]]; then
  echo "config.xml already exists, skipping"
  exit 0
fi
printf '<Config>\n  <ApiKey>%s</ApiKey>\n</Config>\n' \
  "$(cat "${CREDENTIALS_DIRECTORY}/sonarr-api-key")" \
  > "$config_path"
echo "Sonarr config.xml initialized"
