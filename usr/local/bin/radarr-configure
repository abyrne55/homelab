#!/bin/bash
set -euo pipefail

RADARR_URL="http://localhost:20540"
API_KEY=$(cat "${CREDENTIALS_DIRECTORY}/radarr-api-key")
WEBUI_PASS=$(cat "${CREDENTIALS_DIRECTORY}/radarr-webui-password")

# ---- censor setup ----
_censor() {
    local sed_args=()
    for _v in "$@"; do
        [[ -z "$_v" ]] && continue
        local _e; _e=$(printf '%s' "$_v" | sed 's/[\/&]/\\&/g')
        sed_args+=(-e "s/${_e}/[REDACTED]/g")
    done
    sed "${sed_args[@]}"
}
exec > >(_censor "$API_KEY" "$WEBUI_PASS") 2>&1
# ---- end censor setup ----

echo "Checking Radarr authentication configuration..."
CURRENT=$(curl -sf "$RADARR_URL/api/v3/config/host" -H "X-Api-Key: $API_KEY")
CURRENT_AUTH=$(echo "$CURRENT" | jq -r '.authenticationMethod')
CURRENT_USER=$(echo "$CURRENT" | jq -r '.username')

if [ "$CURRENT_AUTH" = "forms" ] && [ "$CURRENT_USER" = "abyrne55" ]; then
  echo "Radarr Forms authentication already configured; skipping"
else
  echo "Enabling Forms authentication on Radarr..."
  UPDATED=$(echo "$CURRENT" | jq \
    --arg pass "$WEBUI_PASS" \
    '.authenticationMethod = "forms" | .authenticationRequired = "enabled" | .username = "abyrne55" | .password = $pass | .passwordConfirmation = $pass')
  curl -sf -X PUT "$RADARR_URL/api/v3/config/host" \
    -H "X-Api-Key: $API_KEY" \
    -H "Content-Type: application/json" \
    -d "$UPDATED"
  echo "Radarr Forms authentication configured successfully"
fi

echo "Checking Radarr root folder configuration..."
ROOT_FOLDER_COUNT=$(curl -sf "$RADARR_URL/api/v3/rootfolder" -H "X-Api-Key: $API_KEY" | jq 'length')
if [ "$ROOT_FOLDER_COUNT" -gt 0 ]; then
  echo "Radarr root folder already configured; skipping"
else
  echo "Adding root folder /content/media/movies..."
  curl -sf -X POST "$RADARR_URL/api/v3/rootfolder" \
    -H "X-Api-Key: $API_KEY" \
    -H "Content-Type: application/json" \
    -d '{"path":"/content/media/movies"}'
  echo "Radarr root folder configured successfully"
fi
