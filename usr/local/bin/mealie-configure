#!/bin/bash
set -euo pipefail

MEALIE_URL="http://127.0.0.1:20590"
TARGET_EMAIL="abyrne55"
TARGET_PASS=$(cat "${CREDENTIALS_DIRECTORY}/mealie-webui-password")

DEFAULT_EMAIL="changeme@example.com"
DEFAULT_PASS="MyPassword"

login() {
  curl -sf -X POST "$MEALIE_URL/api/auth/token" \
    --data-urlencode "username=$1" \
    --data-urlencode "password=$2" \
    | jq -r '.access_token'
}

api() {
  curl -sf -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" "$@"
}

ensure_api_token() {
  local label="$1" key_file="$2"
  if [ -s "$key_file" ]; then
    local stored
    stored=$(cat "$key_file")
    if curl -sf -H "Authorization: Bearer $stored" "$MEALIE_URL/api/users/self" -o /dev/null; then
      echo "$label API token valid; skipping"
      return
    fi
    echo "$label API token on disk is stale; minting a new one..."
  else
    echo "Minting API token for $label..."
  fi
  local resp api_token
  resp=$(api -X POST "$MEALIE_URL/api/users/api-tokens" \
    -d "{\"name\": \"$label\"}")
  api_token=$(echo "$resp" | jq -r '.token')
  if [ -z "$api_token" ] || [ "$api_token" = "null" ]; then
    echo "Failed to mint API token for $label" >&2
    exit 1
  fi
  install -m 0644 /dev/null "$key_file"
  echo -n "$api_token" > "$key_file"
  echo "API token written to $key_file"
}

echo "Checking Mealie admin credentials..."

TOKEN=$(login "$DEFAULT_EMAIL" "$DEFAULT_PASS" 2>/dev/null || true)

if [ -n "$TOKEN" ]; then
  echo "Default credentials still active; updating..."

  SELF=$(api "$MEALIE_URL/api/users/self")
  SELF_ID=$(echo "$SELF" | jq -r '.id')

  echo "Updating admin email..."
  UPDATED=$(echo "$SELF" | jq --arg email "$TARGET_EMAIL" '.email = $email')
  api -o /dev/null -X PUT "$MEALIE_URL/api/users/$SELF_ID" -d "$UPDATED"

  echo "Changing admin password..."
  api -o /dev/null -X PUT "$MEALIE_URL/api/users/password" \
    -d "$(jq -n \
      --arg cur "$DEFAULT_PASS" \
      --arg new "$TARGET_PASS" \
      '{current_password: $cur, new_password: $new}')"

  echo "Mealie admin credentials configured successfully"

  TOKEN=$(login "$TARGET_EMAIL" "$TARGET_PASS")
else
  echo "Default login failed; checking target credentials..."
  TOKEN=$(login "$TARGET_EMAIL" "$TARGET_PASS" 2>/dev/null || true)

  if [ -z "$TOKEN" ]; then
    echo "Both default and target credentials failed — manual intervention required" >&2
    exit 1
  fi

  echo "Mealie admin credentials already configured; skipping"
fi

# Set user display name
SELF=$(api "$MEALIE_URL/api/users/self")
SELF_ID=$(echo "$SELF" | jq -r '.id')
FULL_NAME=$(echo "$SELF" | jq -r '.fullName')

if [ "$FULL_NAME" = "Change Me" ]; then
  echo "Updating user display name..."
  UPDATED=$(echo "$SELF" | jq '.fullName = "Anthony"')
  api -o /dev/null -X PUT "$MEALIE_URL/api/users/$SELF_ID" -d "$UPDATED"
  echo "Display name set to Anthony"
else
  echo "Display name already set to '$FULL_NAME'; skipping"
fi

# Seed foods, units, and labels
FOOD_COUNT=$(api "$MEALIE_URL/api/foods?per_page=1" | jq '.total')
if [ "$FOOD_COUNT" -eq 0 ]; then
  echo "Seeding foods database..."
  api -o /dev/null -X POST "$MEALIE_URL/api/groups/seeders/foods" -d '{"locale": "en-US"}'
  echo "Foods seeded"
else
  echo "Foods already populated ($FOOD_COUNT items); skipping"
fi

UNIT_COUNT=$(api "$MEALIE_URL/api/units?per_page=1" | jq '.total')
if [ "$UNIT_COUNT" -eq 0 ]; then
  echo "Seeding units database..."
  api -o /dev/null -X POST "$MEALIE_URL/api/groups/seeders/units" -d '{"locale": "en-US"}'
  echo "Units seeded"
else
  echo "Units already populated ($UNIT_COUNT items); skipping"
fi

LABEL_COUNT=$(api "$MEALIE_URL/api/groups/labels?per_page=1" | jq '.total')
if [ "$LABEL_COUNT" -eq 0 ]; then
  echo "Seeding labels database..."
  api -o /dev/null -X POST "$MEALIE_URL/api/groups/seeders/labels" -d '{"locale": "en-US"}'
  echo "Labels seeded"
else
  echo "Labels already populated ($LABEL_COUNT items); skipping"
fi

ensure_api_token "mealie-local-ai" "/var/local/lib/mealie/local-ai/api-key"
ensure_api_token "static-mealie" "/var/local/lib/mealie/static-mealie/api-key"
