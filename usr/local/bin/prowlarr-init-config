#!/bin/bash
set -euo pipefail
config_path=/var/local/lib/prowlarr/config/config.xml
marker=/var/local/lib/prowlarr/.init-done
if [[ -f "$marker" ]]; then
  echo "already initialized, skipping"
  exit 0
fi
printf '<Config>\n  <ApiKey>%s</ApiKey>\n</Config>\n' \
  "$(cat "${CREDENTIALS_DIRECTORY}/prowlarr-api-key")" \
  > "$config_path"
touch "$marker"
echo "Prowlarr config.xml initialized"
