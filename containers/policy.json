{
  "default": [{"type": "insecureAcceptAnything"}],
  "transports": {
    "docker": {
      "ghcr.io/abyrne55/caddy-homelab": [{
        "type": "sigstoreSigned",
        "fulcio": {
          "caPath": "/etc/pki/containers/fulcio_v1.crt.pem",
          "oidcIssuer": "https://token.actions.githubusercontent.com",
          "subjectEmail": "https://github.com/abyrne55/caddy-homelab/.github/workflows/docker-publish.yml@refs/heads/main"
        },
        "rekorPublicKeyPath": "/etc/pki/containers/rekor.pub",
        "signedIdentity": {"type": "matchRepository"}
      }]
    }
  }
}
