# Rootless Caddy with socket activation
# Reverse proxy to Jellyfin media server
{
	admin unix//tmp/admin.sock
}

http://localhost {
	bind fd/3 {
		protocols h1
	}
	log

	# Reverse proxy all traffic to Jellyfin
	# host.containers.internal resolves to the host in rootless Podman
	reverse_proxy http://host.containers.internal:8096
}
