{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  branchPrefix: 'renovate-',
  enabledManagers: [
    'custom.regex',
  ],
  pinDigests: true,
  platformAutomerge: true,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/etc/containers/systemd/.*\\.container$/',
      ],
      matchStrings: [
        'Image=(?<depName>[a-zA-Z0-9][a-zA-Z0-9./_-]*):(?<currentValue>[a-zA-Z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      datasourceTemplate: 'docker',
      autoReplaceStringTemplate: 'Image={{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Containerfile$/',
      ],
      matchStrings: [
        'FROM (?<depName>[a-zA-Z0-9][a-zA-Z0-9./_-]*):(?<currentValue>[a-zA-Z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      datasourceTemplate: 'docker',
      autoReplaceStringTemplate: 'FROM {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Containerfile$/',
      ],
      matchStrings: [
        'ARG COSIGN_VERSION=(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'sigstore/cosign',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'docker',
      ],
      enabled: false,
      matchPackageNames: [
        '/^ghcr\\.io/abyrne55//',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'abyrne55/systemd-age-creds',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'lscr.io/linuxserver/qbittorrent',
      ],
      allowedVersions: '<10.0.0',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-assistant/home-assistant',
      ],
      versioning: 'regex:^(?<major>\\d{4})\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$',
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      automerge: false,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'quay.io/fedora/fedora-bootc',
      ],
      allowedVersions: '44',
      schedule: [
        'before 9am on monday',
        'before 9am on thursday',
      ],
    },
  ],
}
