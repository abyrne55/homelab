[Unit]
Description=Initialize data disk with ext4 filesystem
DefaultDependencies=no
Before=var-mnt-media.mount
After=systemd-udevd.service
ConditionPathExists=!/dev/disk/by-label/media-data

[Service]
Type=oneshot
ExecStart=/usr/sbin/mkfs.ext4 -L media-data /dev/vdb
ExecStart=/usr/bin/mkdir -p /var/mnt/media
ExecStart=/usr/bin/mount /dev/vdb /var/mnt/media
ExecStart=/usr/bin/mkdir -p /var/mnt/media/Movies /var/mnt/media/TV /var/mnt/media/.jellyfin/config /var/mnt/media/.jellyfin/cache
ExecStart=/usr/bin/chown -R 1052:1052 /var/mnt/media
ExecStart=/usr/bin/umount /var/mnt/media
RemainAfterExit=yes

[Install]
WantedBy=var-mnt-media.mount
